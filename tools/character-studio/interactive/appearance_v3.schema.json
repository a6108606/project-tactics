              },
              "clothing1": {
                "pattern": "^#[eE][dD][eE]3[cC][fF]$"
              },
              "clothing2": {
                "pattern": "^#696444$"
              },
              "clothing3": {
                "pattern": "^#[bB][dD]633[eE]$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "character_id": {
            "const": "leo"
          }
        }
      },
      "then": {
        "properties": {
          "source_sha256": {
            "const": "0db3e6ecf23e6717961254f5117f14a2858cd673b7ef2f17a615f2bcce01bc71"
          },
          "colors": {
            "properties": {
              "skin": {
                "pattern": "^#[fF]2[bB][cC]85$"
              },
              "hair": {
                "pattern": "^#8[dD]6952$"
              },
              "clothing1": {
                "pattern": "^#[eE][eE][eE]1[cC][aA]$"
