{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-tactics/appearance-v3",
  "title": "Appearance V3 — Ryuu visible-mask pilot",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "project-tactics/appearance"
    },
    "schema_version": {
      "const": 3
    },
    "asset_manifest_version": {
      "const": "ryuu-visible-1"
    },
    "character_id": {
      "enum": [
        "ryuu",
        "kael",
        "sela",
        "leo",
        "lina"
      ]
    },
    "body_variant_id": {
      "enum": [
        "masculine",
        "feminine"
      ]
    },
    "view_id": {
      "const": "main"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "face_variant_id": {
      "const": "canonical"
    },
    "hair_variant_id": {
      "const": "canonical"
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skin",
        "hair",
        "clothing1",
        "clothing2",
        "clothing3"
      ],
      "properties": {
        "skin": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "hair": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "clothing1": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "clothing2": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "clothing3": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "equipment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "visible"
      ],
      "properties": {
        "mode": {
          "const": "source-locked"
        },
        "visible": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "character_id": {
            "const": "ryuu"
          }
        }
      },
      "then": {
        "properties": {
          "source_sha256": {
            "const": "8d7e17983eee6b29abea9e7f4a52b87eb32a8c74771442591ad846913a475c20"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "character_id": {
            "const": "kael"
          }
        }
      },
      "then": {
        "properties": {
          "source_sha256": {
            "const": "6e922784ee9d86a10cfc2e6ba117a2dc966edbd8c3bf2ba51461a62a1cb2b0c1"
          },
          "colors": {
            "properties": {
              "skin": {
                "pattern": "^#[fF]2[bB][eE]87$"
              },
              "hair": {
                "pattern": "^#[fF]4[dD]377$"
              },
              "clothing1": {
                "pattern": "^#704293$"
              },
              "clothing2": {
