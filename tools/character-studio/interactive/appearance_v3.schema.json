          },
          "colors": {
            "properties": {
              "skin": {
                "pattern": "^#[fF]3[cC]38[fF]$"
              },
              "hair": {
                "pattern": "^#[eE]8[eE]0[dD]2$"
              },
              "clothing1": {
                "pattern": "^#[fF]0[dD]575$"
              },
              "clothing2": {
                "pattern": "^#[fF]7[eE]9[cC][bB]$"
              },
              "clothing3": {
                "pattern": "^#[dD]6[aA]244$"
              }
            }
          }
        }
      }
    }
  ],
  "required": [
    "schema",
    "schema_version",
    "asset_manifest_version",
    "character_id",
    "body_variant_id",
    "view_id",
    "source_sha256",
    "face_variant_id",
    "hair_variant_id",
    "colors",
    "equipment"
  ]
}
